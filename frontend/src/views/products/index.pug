extends ../layout

block content
  h1.page-title= title || 'Productos'
  p.page-sub Explora nuestro catálogo antártico.

  form.toolbar(action='/products', method='GET')
    .search
      span.icon 🔍
      input(type='search', name='q', placeholder='Buscar productos...', aria-label='Buscar productos', value=(query || ''))
    select.select(name='category', aria-label='Filtrar por categoría')
      option(value='', selected=!category) Todas las categorías
      option(value='fish', selected=category === 'fish') Pescado
      option(value='ice', selected=category === 'ice') Hielo
      option(value='clothing', selected=category === 'clothing') Ropa
      option(value='accessories', selected=category === 'accessories') Accesorios
    button.btn.btn-primary.btn-auto(type='submit') Buscar

  if products && products.length
    .product-grid
      each product in products
        - const price = Number(product.price || 0).toFixed(2).replace('.', ',')
        article.product-card
          a.thumb(href=`/products/${product._id}`, aria-label=`Ver ${product.name}`)
            if product.imageUrl
              img(src=product.imageUrl, alt=product.name, loading='lazy')
            else
              span 🐧
          .info
            h3
              a(href=`/products/${product._id}`)= product.name
            .price-row
              span.price= `${price} €`
              if product.stock > 0
                span.badge.stock En stock
              else
                span.badge.nostock Sin stock
            form(action=`/cart/add/${product._id}`, method='POST')
              button.btn.btn-primary(type='submit', disabled=product.stock <= 0)= product.stock > 0 ? 'Añadir al carrito' : 'Sin stock'
  else
    .empty
      span.big 🐧
      p= query || category ? 'No hay productos que coincidan con tu búsqueda.' : 'No hay productos disponibles en este momento.'
      a.btn.btn-ghost.btn-auto(href='/') Volver al inicio
