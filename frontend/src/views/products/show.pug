extends ../layout

block content
  a(href='/products') ← Volver a productos

  .product-detail
    if product.imageUrl
      img.product-image(src=product.imageUrl alt=product.name)
    else
      .product-image.placeholder Imagen no disponible

    .product-info
      span.category-badge= product.category === 'fish' ? 'Pescado' : product.category === 'ice' ? 'Hielo' : product.category === 'clothing' ? 'Ropa' : 'Accesorios'
      h1= product.name
      p.price= `${Number(product.price || 0).toFixed(2)} €`
      p.description= product.description
      p Stock disponible: #{product.stock}

      form(action=`/cart/add/${product._id}` method='POST')
        button(type='submit' disabled=product.stock <= 0)
          = product.stock > 0 ? 'Añadir al carrito' : 'Sin stock'
