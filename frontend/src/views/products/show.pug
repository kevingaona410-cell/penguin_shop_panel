extends ../layout

block content
  - const catLabel = product.category === 'fish' ? 'Pescado' : product.category === 'ice' ? 'Hielo' : product.category === 'clothing' ? 'Ropa' : 'Accesorios'
  - const price = Number(product.price || 0).toFixed(2).replace('.', ',')

  .detail
    .detail-gallery
      .main-img
        if product.imageUrl
          img(src=product.imageUrl, alt=product.name)
        else
          span 🐧
      .thumbs(aria-hidden='true')
        .thumb.active
          if product.imageUrl
            img(src=product.imageUrl, alt='')
          else
            span 🐧
        .thumb
          span 🧊
        .thumb
          span 🎒
        .thumb
          span 🐧

    .detail-info
      h1= product.name
      .detail-price
        span.price= `${price} €`
        if product.stock > 0
          span.badge.stock En stock
        else
          span.badge.nostock Sin stock
      p.detail-desc= product.description
      ul.spec
        li
          | • Categoría: 
          strong= catLabel
        li
          | • Stock disponible: 
          strong= `${product.stock} uds.`
      .buy-row
        span.qty-static Cantidad: &nbsp;1
        form(action=`/cart/add/${product._id}`, method='POST', style='flex:1; display:flex;')
          button.btn.btn-primary(type='submit', disabled=product.stock <= 0)= product.stock > 0 ? 'Añadir al carrito' : 'Sin stock'

  a.link-back(href='/products') ← Volver al catálogo
