extends ../layout

block content
  h1.page-title= title || 'Tu carrito'

  if !items || items.length === 0
    .empty
      span.big 🛒
      p Tu carrito está vacío.
      a.btn.btn-primary.btn-auto(href='/products') Ver productos
  else
    .table-wrap
      table.table
        thead
          tr
            th Producto
            th Precio unitario
            th Cantidad
            th Subtotal
            th Acciones
        tbody
          each item in items
            - const unit = Number(item.product.price || 0).toFixed(2).replace('.', ',')
            - const sub = Number(item.subtotal || 0).toFixed(2).replace('.', ',')
            tr
              td(data-label='Producto')
                .cell-product
                  span.mini
                    if item.product.imageUrl
                      img(src=item.product.imageUrl, alt=item.product.name)
                    else
                      | 🐧
                  span= item.product.name
              td(data-label='Precio unitario')= `${unit} €`
              td(data-label='Cantidad')
                .qty
                  form(action=`/cart/update/${item.product._id}`, method='POST', style='display:inline;')
                    input(type='hidden', name='_method', value='PUT')
                    input(type='hidden', name='quantity', value=item.quantity - 1)
                    button(type='submit', aria-label='Disminuir cantidad', disabled=item.quantity <= 1) −
                  form(action=`/cart/update/${item.product._id}`, method='POST', style='display:inline;')
                    input(type='hidden', name='_method', value='PUT')
                    input(type='number', name='quantity', value=item.quantity, min='1', max=item.product.stock, aria-label='Cantidad')
                    button(type='submit', aria-label='Actualizar cantidad') ✓
                  form(action=`/cart/update/${item.product._id}`, method='POST', style='display:inline;')
                    input(type='hidden', name='_method', value='PUT')
                    input(type='hidden', name='quantity', value=item.quantity + 1)
                    button(type='submit', aria-label='Aumentar cantidad', disabled=item.quantity >= item.product.stock) +
              td(data-label='Subtotal')= `${sub} €`
              td(data-label='Acciones')
                form(action=`/cart/remove/${item.product._id}`, method='POST', style='display:inline;')
                  input(type='hidden', name='_method', value='DELETE')
                  button.btn-danger-link(type='submit') 🗑 Eliminar

    .cart-footer
      form(action='/cart/clear', method='POST')
        input(type='hidden', name='_method', value='DELETE')
        button.btn.btn-ghost.btn-auto(type='submit') 🗑 Vaciar carrito
      .total-line Total: <span class='amount'>#{Number(total || 0).toFixed(2).replace('.', ',')} €</span>

    .cart-footer
      a.link-back(href='/products', style='margin-top:0;') ← Seguir comprando
      a.btn.btn-primary.btn-auto(href='/orders/checkout') Ir al checkout →
