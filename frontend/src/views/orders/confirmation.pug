extends ../layout

block content
  .confirm
    span.confirm-icon ✓
    h2 ¡Pedido confirmado!
    p Gracias por tu compra. Tu pedido ha sido registrado correctamente.

    if order
      .panel
        dl.kv
          dt Número de pedido:
          dd= order._id
          dt Fecha:
          dd= order.createdAt ? new Date(order.createdAt).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'
          dt Estado:
          dd
            - const st = order.status
            - const stLabel = st === 'pending' ? 'Pendiente' : st === 'preparing' ? 'En preparación' : st === 'shipped' ? 'Enviado' : st === 'delivered' ? 'Entregado' : 'Cancelado'
            span.badge(class=st)= stLabel

    .confirm-actions
      a.btn.btn-primary.btn-auto(href='/orders') Ver mis pedidos
      a.btn.btn-ghost.btn-auto(href='/products') Seguir comprando
