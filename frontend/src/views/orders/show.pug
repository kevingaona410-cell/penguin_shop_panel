extends ../layout

block content
  a.link-back(href='/orders', style='margin-top:0;') ← Volver a mis pedidos

  - const st = order.status
  - const stLabel = st === 'pending' ? 'Pendiente' : st === 'preparing' ? 'En preparación' : st === 'shipped' ? 'Enviado' : st === 'delivered' ? 'Entregado' : 'Cancelado'

  h1.page-title.mt Pedido ##{order._id}

  .detail.detail-order
    .panel
      dl.kv
        dt Fecha:
        dd= order.createdAt ? new Date(order.createdAt).toLocaleString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—'
        dt Estado:
        dd
          span.badge(class=st)= stLabel
        dt Cliente:
        dd= order.customerName
        dt Dirección:
        dd= order.deliveryAddress
      if order.status === 'pending' || order.status === 'preparing'
        form.mt(action=`/orders/${order._id}/cancel`, method='POST')
          input(type='hidden', name='_method', value='PATCH')
          button.btn-danger-outline(type='submit') ⊘ Cancelar pedido

    div
      h2.section-title(style='margin-top:0;') Productos
      .table-wrap
        table.table
          thead
            tr
              th Producto
              th Cantidad
              th Precio unitario
              th Subtotal
          tbody
            each item in order.items
              tr
                td(data-label='Producto')= item.productName
                td(data-label='Cantidad')= item.quantity
                td(data-label='Precio unitario')= `${Number(item.unitPrice).toFixed(2).replace('.', ',')} €`
                td(data-label='Subtotal')= `${Number(item.subtotal).toFixed(2).replace('.', ',')} €`
      .row-between.mt
        strong Total
        strong.total-line
          span.amount= `${Number(order.total).toFixed(2).replace('.', ',')} €`
