extends ../layout

block content
  h1.page-title= title || 'Revisar pedido'
  p.page-sub Revisa tus datos antes de confirmar.

  h2.section-title Datos del cliente
  form(action='/orders', method='POST')
    .form-grid
      .field
        label(for='customerName') Nombre
        input#customerName(type='text', name='customerName', placeholder='Juan Pérez', required, minlength='2', maxlength='100', value=(typeof customerName !== 'undefined' ? customerName : ''))
      .field
        label(for='deliveryAddress') Dirección de entrega
        input#deliveryAddress(type='text', name='deliveryAddress', placeholder='Calle del Sol 123, Madrid', required, minlength='5', maxlength='250', value=(typeof deliveryAddress !== 'undefined' ? deliveryAddress : ''))

    h2.section-title Productos
    .table-wrap
      table.table
        thead
          tr
            th Producto
            th Cantidad
            th Precio unitario
            th Subtotal
        tbody
          each item in items
            tr
              td(data-label='Producto')
                .cell-product
                  span.mini
                    if item.product.imageUrl
                      img(src=item.product.imageUrl, alt=item.product.name)
                    else
                      | 🐧
                  span= item.product.name
              td(data-label='Cantidad')= item.quantity
              td(data-label='Precio unitario')= `${Number(item.product.price).toFixed(2).replace('.', ',')} €`
              td(data-label='Subtotal')= `${Number(item.subtotal).toFixed(2).replace('.', ',')} €`

    .row-between.mt
      strong Total
      strong.total-line
        span.amount= `${Number(total).toFixed(2).replace('.', ',')} €`

    .cart-footer
      a.link-back(href='/cart', style='margin-top:0;') ← Volver al carrito
      button.btn.btn-primary.btn-auto(type='submit') Confirmar pedido
