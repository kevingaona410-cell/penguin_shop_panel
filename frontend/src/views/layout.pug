doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title ? `${title} · Penguin Shop` : 'Penguin Shop'
    link(rel='stylesheet', href='/css/styles.css')
  body
    .app
      header.topbar
        a.brand(href='/')
          span.brand-mark 🐧
          span Penguin Shop
        input#nav-toggle.nav-toggle(type='checkbox')
        label.hamburger(for='nav-toggle', aria-label='Abrir menú') ☰
        nav.mainnav
          - const current = typeof currentPath !== 'undefined' ? currentPath : ''
          a(href='/' class=(current === '/' ? 'active' : '')) Inicio
          a(href='/products' class=(current && current.startsWith('/products') ? 'active' : '')) Productos
          a(href='/cart' class=(current && current.startsWith('/cart') ? 'active' : '')) Carrito
          a(href='/orders' class=(current && current.startsWith('/orders') ? 'active' : '')) Mis pedidos
        a.cart-btn(href='/cart', aria-label='Ver carrito') 🛒
          if typeof cartCount !== 'undefined' && cartCount > 0
            span.cart-count= cartCount

      .page
        .page-body
          block content
        .iceberg(aria-hidden='true')
          svg(viewBox='0 0 1200 90', preserveAspectRatio='none')
            path(d='M0,60 L90,25 L170,55 L260,20 L340,55 L430,30 L520,58 L610,28 L700,55 L790,22 L880,55 L970,30 L1060,58 L1140,32 L1200,55 L1200,90 L0,90 Z', fill='#bfe0f4')
            path(d='M0,72 L120,48 L240,70 L360,50 L480,72 L600,52 L720,72 L840,50 L960,72 L1080,52 L1200,70 L1200,90 L0,90 Z', fill='#d8eefc')
            path(d='M0,82 L200,66 L420,80 L640,66 L860,80 L1080,66 L1200,78 L1200,90 L0,90 Z', fill='#eaf6fe')
          span.penguin-mini 🐧
