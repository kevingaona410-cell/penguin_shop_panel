extends ../layout

block content
  article
    header
      h1= product.name

    if product.imageUrl
      img(
        src=product.imageUrl
        alt=`Imagen de ${product.name}`
      )

    dl
      dt Descripción
      dd= product.description

      dt Categoría
      dd= product.category

      dt Precio
      dd= product.price

      dt Stock
      dd= product.stock

      dt Estado
      dd= product.isActive ? 'Activo' : 'Inactivo'

      dt Creado
      dd= product.createdAt

      dt Última actualización
      dd= product.updatedAt

    nav
      a(href="/admin/products") Volver
      | 
      a(href=`/admin/products/${product._id}/edit`) Editar

    form(
      action=`/admin/products/${product._id}?_method=DELETE`
      method="POST"
    )
      button(type="submit") Eliminar producto