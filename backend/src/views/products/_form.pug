if errors && Object.keys(errors).length > 0
  section.alert.alert-error(role='alert')
    strong No se pudo guardar el producto
    ul
      each error in Object.values(errors)
        li= error

form.form-card(action=formAction method='POST')
  input(type='hidden' name='_csrf' value=csrfToken)
  .form-card-header
    p.eyebrow Información del producto
    h2 Datos principales
    p Completa los campos para mantener el catálogo actualizado.

  .form-grid
    div.form-field.form-field-wide
      label(for='name') Nombre del producto
      input#name(name='name' type='text' value=product.name || '' minlength='2' maxlength='100' required placeholder='Ej. Kit de pesca polar')

    div.form-field.form-field-wide
      label(for='description') Descripción
      textarea#description(name='description' maxlength='500' required placeholder='Describe brevemente el producto')= product.description || ''

    div.form-field
      label(for='price') Precio
      .input-with-suffix
        input#price(name='price' type='number' value=product.price min='0' step='0.01' required placeholder='0.00')
        span €

    div.form-field
      label(for='stock') Stock disponible
      input#stock(name='stock' type='number' value=product.stock min='0' step='1' required placeholder='0')

    div.form-field
      label(for='category') Categoría
      select#category(name='category' required)
        option(value='') Selecciona una categoría
        option(value='fish' selected=product.category === 'fish') Pescado
        option(value='ice' selected=product.category === 'ice') Hielo
        option(value='clothing' selected=product.category === 'clothing') Ropa
        option(value='accessories' selected=product.category === 'accessories') Accesorios

    div.form-field
      label(for='imageUrl') URL de la imagen
      input#imageUrl(name='imageUrl' type='url' value=product.imageUrl || '' placeholder='https://...')

  label.checkbox-field(for='isActive')
    input#isActive(name='isActive' type='checkbox' checked=product.isActive !== false)
    span
      strong Producto activo
      small Visible para los clientes de la tienda

  .form-actions
    a.button.button-secondary(href='/admin/products') Cancelar
    button.button.button-primary(type='submit')= submitLabel